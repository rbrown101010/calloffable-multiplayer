# Copy to .env for local server runs. Never commit real values.
# On Fly.io set these with `fly secrets set NAME=value`.

# Shared secret players type on the JOIN LOBBY screen.
LOBBY_PASSWORD=

# Optional: entering this instead of the lobby password makes you host.
HOST_PASSWORD=

# LiveKit Cloud project (voice chat). The client never sees these;
# the game server mints short-lived tokens after the lobby password passes.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Existing: only needed to regenerate announcer/operator lines (tools/voice.mjs).
AI_GATEWAY_API_KEY=
