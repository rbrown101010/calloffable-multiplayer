{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {"source": "/api/(.*)", "headers": [{"key":"Cache-Control","value":"no-store"}]},
    {"source": "/(.*)", "headers": [{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Permissions-Policy","value":"microphone=(self), camera=()"}]}
  ]
}
